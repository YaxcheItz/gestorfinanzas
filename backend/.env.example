# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (SUPABASE)
# ==========================================
# Copia este archivo como .env y coloca tus credenciales reales.
# En Supabase: Project Settings -> Database -> Connection string (URI / Session Pooler)
#
# Ejemplo con Transaction Pooler (Puerto 6543):
# DB_URL=jdbc:postgresql://aws-0-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require
# DB_USERNAME=postgres.tu_project_ref
# DB_PASSWORD=tu_contraseña_de_supabase
# DB_SCHEMA=finanzas

DB_URL=jdbc:postgresql://localhost:5432/gestion_finanzas_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=finanzas

# ==========================================
# SEGURIDAD Y JWT
# ==========================================
# Clave secreta hexadecimal o alfanumérica de mínimo 32 caracteres (256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
CORS_ORIGINS=http://localhost:4200
