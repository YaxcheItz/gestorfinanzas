# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (SUPABASE)
# ==========================================
# Copia este archivo como .env y coloca tus credenciales reales.
# En Supabase: Project Settings -> Database -> Connection string (URI / Session Pooler)
#
# Ejemplo con Transaction Pooler (Puerto 6543):
# DB_URL=jdbc:postgresql://aws-0-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require
# DB_USERNAME=postgres.tu_project_ref
# DB_PASSWORD=tu_contraseña_de_supabase
# DB_SCHEMA=finanzas

DB_URL=jdbc:postgresql://localhost:5432/gestion_finanzas_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=finanzas

# ==========================================
# SEGURIDAD Y JWT
# ==========================================
# Clave secreta hexadecimal o alfanumérica de mínimo 32 caracteres (256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
CORS_ORIGINS=http://localhost:4200

# ==========================================
# RECUPERACIÃ“N DE CUENTA (SMTP)
# ==========================================
# Configura un servidor de correo antes de habilitar el envÃ­o de enlaces de recuperaciÃ³n.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@kaptal.app
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
FRONTEND_URL=http://localhost:4200

# ==========================================
# INTELIGENCIA ARTIFICIAL (GEMINI)
# ==========================================
# Crea una clave en Google AI Studio y guárdala solo en backend/.env local.
# No compartas ni subas esta clave a Git.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
# Se usa automáticamente si el modelo principal devuelve error de cuota (HTTP 429).
AI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
