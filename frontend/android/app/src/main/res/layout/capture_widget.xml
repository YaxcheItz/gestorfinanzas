<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="#182522">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/capture_widget_name" android:textColor="#FFFFFF" android:textSize="16sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/capture_expense" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/capture_expense" />
        <Button android:id="@+id/capture_income" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/capture_income" />
        <Button android:id="@+id/capture_voice" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/capture_voice" />
    </LinearLayout>
</LinearLayout>
