{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "start:e2e": "ng serve --proxy-config proxy.e2e.conf.json",
    "start:lan": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "security:check": "node --test scripts/check-dependencies.test.mjs && node scripts/check-dependencies.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "21.2.25",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lucide/angular": "^1.47.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "xcode": { "uuid": "^11.1.1" },
    "piscina": "^5.3.2",
    "vite": "^7.3.7",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "tailwindcss": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
